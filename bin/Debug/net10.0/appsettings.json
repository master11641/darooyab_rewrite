{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Authentication": {
    "CookieName": "Darooyab.Authentication",
    "ExpireTimeSpan": "00:45:00",
    "SlidingExpiration": true,
    "EnablePasswordRehash": false,
    "LoginPath": "/ph/login",
    "LogoutPath": "/ph/logout",
    "MaxLoginAttemptsPerIp": 5,
    "LoginRateLimitWindow": "00:10:00"
  },
  "Captcha": {
    "Enabled": true,
    "TextLength": 5,
    "ImageWidth": 180,
    "ImageHeight": 64,
    "ChallengeLifetime": "00:05:00",
    "MaxFailedAttempts": 5,
    "MaxActiveChallengesPerClient": 20,
    "RateLimitWindow": "00:10:00",
    "MaxGenerateRequestsPerClient": 20,
    "MaxGenerateRequestsPerIp": 120,
    "MaxValidationRequestsPerClient": 20,
    "MaxValidationRequestsPerIp": 120,
    "MaxApiRequestsPerIp": 240,
    "ApiRateLimitWindow": "00:10:00",
    "MaxPublicFeedbackRequestsPerIp": 10,
    "PublicFeedbackRateLimitWindow": "00:10:00",
    "NoisePixelCount": 180,
    "InterferenceLineCount": 4,
    "StorageMode": "Memory"
  },
  "Wallet": {
    "ZarinPal": {
      "MerchantId": "6629c959-f945-4fca-98c9-523d0787dab4",
      "CallbackUrl": "https://www.darooyab.ir/Wallet/Callback"
    }
  },
  "AllowedHosts": "*"
}
