@model AdminDashboardViewModel
@using System.Globalization
@{
    ViewData["Title"] = "داشبورد";
}

<div class="admin-page">
    <nav class="admin-breadcrumb" aria-label="مسیر صفحه">
        <span>پنل داروخانه</span>
        <span aria-hidden="true">/</span>
        <span aria-current="page">داشبورد</span>
    </nav>

    <section class="admin-welcome" aria-labelledby="welcome-title">
        <div class="admin-welcome-copy">
            <span class="admin-eyebrow">فضای کاری داروخانه</span>
            <h2 id="welcome-title">خوش آمدید</h2>
            <p>خلاصه‌ی وضعیت داروخانه و دسترسی سریع به عملیات پرکاربرد.</p>
        </div>
        <div class="admin-pharmacy-card">
            <span class="admin-pharmacy-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M3 21h18M5 21V7l7-4 7 4v14M9 10h.01M15 10h.01M9 14h.01M15 14h.01M10 21v-4h4v4" /></svg>
            </span>
            <span class="admin-pharmacy-copy">
                <small>داروخانه‌ی شما</small>
                <strong>@Model.PharmacyName</strong>
            </span>
        </div>
    </section>

    <section class="admin-section" aria-labelledby="overview-title">
        <div class="admin-section-heading">
            <div>
                <span class="admin-eyebrow">نمای کلی</span>
                <h2 id="overview-title">خلاصه‌ی وضعیت</h2>
            </div>
            <span class="admin-data-label">
                <span class="admin-status-dot" aria-hidden="true"></span>
                آمار ثبت‌شده
            </span>
        </div>
        <div class="admin-overview-grid">
            <article class="admin-stat-card">
                <span class="admin-stat-icon admin-stat-icon-blue" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M3 21h18M5 21V7l7-4 7 4v14M9 10h.01M15 10h.01M9 14h.01M15 14h.01" /></svg>
                </span>
                <div class="admin-stat-copy">
                    <small>موجودی‌های ارجاع بیمار</small>
                    <strong>@Model.ValidReferralCount.ToString("N0", CultureInfo.InvariantCulture) معتبر</strong>
                    <dl class="admin-metric-details">
                        <div>
                            <dt>منقضی</dt>
                            <dd>@Model.ExpiredReferralCount.ToString("N0", CultureInfo.InvariantCulture)</dd>
                        </div>
                        <div>
                            <dt>کل دارای تاریخ پایان</dt>
                            <dd>@((Model.ValidReferralCount + Model.ExpiredReferralCount).ToString("N0", CultureInfo.InvariantCulture))</dd>
                        </div>
                    </dl>
                    <a class="admin-dashboard-stat-link" href="/PharmacyRequest/AddOrEdit">مشاهده موجودی‌ها</a>
                </div>
            </article>
            <article class="admin-stat-card">
                <span class="admin-stat-icon admin-stat-icon-teal" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M12 3 4 7v5c0 5 3.4 8 8 9 4.6-1 8-4 8-9V7l-8-4Zm-3 9 2 2 4-4" /></svg>
                </span>
                <div class="admin-stat-copy">
                    <small>رتبه‌های خریداری‌شده</small>
                    <strong>@Model.PurchasedRankingCount.ToString("N0", CultureInfo.InvariantCulture)</strong>
                    <dl class="admin-metric-details">
                        <div>
                            <dt>فعال</dt>
                            <dd>@Model.ActiveRankingCount.ToString("N0", CultureInfo.InvariantCulture)</dd>
                        </div>
                        <div>
                            <dt>مجموع خرید</dt>
                            <dd>@Model.PurchasedRankingAmountToman.ToString("N0", CultureInfo.InvariantCulture) تومان</dd>
                        </div>
                    </dl>
                    <a class="admin-dashboard-stat-link" href="/Wallet/Rankings">تاریخچه رتبه‌ها</a>
                </div>
            </article>
            <article class="admin-stat-card">
                <span class="admin-stat-icon admin-stat-icon-violet" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M4 19V5m0 14h16M8 15l3-4 3 2 5-7" /></svg>
                </span>
                <div class="admin-stat-copy">
                    <small>نسخه‌های ارجاعی</small>
                    <strong>@Model.TotalPrescriptionCount.ToString("N0", CultureInfo.InvariantCulture) کل</strong>
                    <dl class="admin-metric-details">
                        <div>
                            <dt>بررسی‌نشده</dt>
                            <dd>@Model.UnreviewedPrescriptionCount.ToString("N0", CultureInfo.InvariantCulture)</dd>
                        </div>
                        <div>
                            <dt>بررسی‌شده</dt>
                            <dd>@Model.ReviewedPrescriptionCount.ToString("N0", CultureInfo.InvariantCulture)</dd>
                        </div>
                    </dl>
                    <a class="admin-dashboard-stat-link" href="/PharmacyRequest/DarooyabPrescription">مدیریت نسخه‌ها</a>
                </div>
            </article>
            <article class="admin-stat-card">
                <span class="admin-stat-icon admin-stat-icon-blue" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><rect x="3" y="6" width="18" height="14" rx="2" /><path d="M3 9h18M16 14h2" /></svg>
                </span>
                <div class="admin-stat-copy">
                    <small>مانده قابل استفاده کیف پول</small>
                    <strong>@Model.WalletBalanceToman.ToString("N0", CultureInfo.InvariantCulture) تومان</strong>
                    <span>پس از کسر هزینه‌های ثبت‌شده</span>
                    <a class="admin-dashboard-stat-link" href="/Wallet">مشاهده کیف پول</a>
                </div>
            </article>
        </div>
    </section>

    <section class="admin-activity-grid" aria-label="دسترسی‌ها و اطلاعات حساب">
        <article class="admin-panel-card">
            <div class="admin-section-heading">
                <div>
                    <span class="admin-eyebrow">میانبر</span>
                    <h2>دسترسی سریع</h2>
                </div>
            </div>
            <div class="admin-dashboard-quick-links">
                <a href="/DarooyabPharmacy/PharmacySpecialties">مدیریت اطلاعات داروخانه</a>
                <a href="/PharmacyRequest/TabadolManage">مدیریت مازاد برای تبادل</a>
                <a href="/DrugShortage/AddOrEdit">ثبت کسری داروخانه</a>
                <a href="/PharmacyAccount/DrugDistribution">تازه‌های شرکت پخش</a>
                <a href="/DrugShortage/otherPhNearDateDrugShortageList">اقلام تاریخ نزدیک</a>
            </div>
        </article>
        <aside class="admin-panel-card admin-account-card">
            <span class="admin-eyebrow">حساب کاربری</span>
            <h2>اطلاعات ورود</h2>
            <dl class="admin-account-details">
                <div>
                    <dt>نام کاربری</dt>
                    <dd dir="ltr">@Model.UserName</dd>
                </div>
                <div>
                    <dt>نوع حساب</dt>
                    <dd>مدیر داروخانه</dd>
                </div>
            </dl>
            <form asp-area="" asp-controller="PharmacyAuthentication" asp-action="Logout" method="post">
                <button class="admin-secondary-button" type="submit">
                    خروج امن از حساب
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 17l5-5-5-5m5 5H3m9-9h6a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-6" /></svg>
                </button>
            </form>
        </aside>
    </section>
</div>
