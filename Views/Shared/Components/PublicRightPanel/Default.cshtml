@model darooyab_rewrite.ViewModels.PublicRightPanelViewModel

@{
    var currentPath = ViewContext.HttpContext.Request.Path.Value ?? string.Empty;
    var isBrandPage = currentPath.StartsWith("/B-", StringComparison.OrdinalIgnoreCase);
    var isGenericDrugPage = currentPath.StartsWith("/G-", StringComparison.OrdinalIgnoreCase);
}

@functions {
    private static (int Width, int Height)? GetAdvertisementDimensions(string? imageUrl)
    {
        if (imageUrl is null)
        {
            return null;
        }

        return imageUrl switch
        {
            "/Content/AdvertisementImages/c2c847ff-4303-4b92-8ab3-16ac2229b260_Dr.Abidi-Diabetes-Gift-Gelotrio-FA-010307-V02.gif" => (260, 160),
            "/Content/AdvertisementImages/2bf4af54-9130-4dc4-a8e7-6cf70e72f834_banner(1).gif" => (260, 160),
            "/Content/AdvertisementImages/6cdf631b-05b6-4828-a649-b1c824eb9e22_3___-web-gift (1).gif" => (260, 160),
            "/Content/AdvertisementImages/def2f898-9d33-41e7-a383-96dbdec231a8_faramox.gif" => (264, 170),
            "/Content/AdvertisementImages/dfd4867c-060a-4f87-a450-9841f6fdf57b_Ursobil Gif.gif" => (260, 160),
            "/Content/AdvertisementImages/5551676e-7137-4d2f-85d5-4b64a2cb75de_darooyab-app_banner2.jpg" => (264, 74),
            _ => null,
        };
    }
}

<div class="public-right-panel" aria-label="دسترسی‌ها و مطالب مرتبط">
    @if (ViewData["ShowQuickAccess"] is true)
    {
        <nav class="right-panel-card" aria-label="دسترسی سریع">
            <h2 class="right-panel-title">دسترسی سریع</h2>
            <a asp-controller="Home" asp-action="Section" asp-route-id="drugs">اطلاعات دارویی</a>
            <a asp-route="PharmacyDirectory">داروخانه‌ها</a>
            <a asp-controller="Home" asp-action="Section" asp-route-id="shortages">داروهای کمیاب</a>
            <a asp-controller="Home" asp-action="Section" asp-route-id="news">تازه‌های دارویی</a>
        </nav>
    }

    @if (Model.PublicAdvertisements.Count > 0)
    {
        <section class="right-panel-card public-advertisement-panel" aria-labelledby="public-advertisement-title">
            <h2 class="right-panel-title" id="public-advertisement-title">آگهی‌های عمومی</h2>
            @foreach (var advertisement in Model.PublicAdvertisements)
            {
                var link = advertisement.Link;
                var imageUrl = string.IsNullOrWhiteSpace(advertisement.ImageUrl)
                    ? null
                    : Url.Content(advertisement.ImageUrl);
                var imageDimensions = isBrandPage || isGenericDrugPage
                    ? GetAdvertisementDimensions(imageUrl)
                    : null;
                var isLcpAdvertisementImage = isBrandPage &&
                    string.Equals(
                        imageUrl,
                        "/Content/AdvertisementImages/2bf4af54-9130-4dc4-a8e7-6cf70e72f834_banner(1).gif",
                        StringComparison.OrdinalIgnoreCase);
                var isSafeLink = !string.IsNullOrWhiteSpace(link) &&
                    (Url.IsLocalUrl(link) ||
                     (Uri.TryCreate(link, UriKind.Absolute, out var absoluteLink) &&
                      (absoluteLink.Scheme == Uri.UriSchemeHttps || absoluteLink.Scheme == Uri.UriSchemeHttp)));

                <article class="public-advertisement-card">
                    @if (isSafeLink)
                    {
                        <a href="@link" rel="sponsored noopener noreferrer">
                            @if (imageUrl is not null)
                            {
                                <img src="@imageUrl" alt="@advertisement.ImageAlt" loading="lazy"
                                     width="@imageDimensions?.Width" height="@imageDimensions?.Height"
                                     fetchpriority="@(isLcpAdvertisementImage ? "high" : null)" />
                            }
                            <span>@(string.IsNullOrWhiteSpace(advertisement.ImageAlt) ? "مشاهده‌ی آگهی" : advertisement.ImageAlt)</span>
                        </a>
                    }
                    else
                    {
                        @if (imageUrl is not null)
                        {
                            <img src="@imageUrl" alt="@advertisement.ImageAlt" loading="lazy"
                                 width="@imageDimensions?.Width" height="@imageDimensions?.Height"
                                 fetchpriority="@(isLcpAdvertisementImage ? "high" : null)" />
                        }
                        <span>@(string.IsNullOrWhiteSpace(advertisement.ImageAlt) ? "آگهی عمومی" : advertisement.ImageAlt)</span>
                    }
                </article>
            }
        </section>
    }

    @if (Model.Advertisements.Count > 0)
    {
        <section class="right-panel-card sponsored-panel" aria-labelledby="sponsored-panel-title">
            <h2 class="right-panel-title" id="sponsored-panel-title">معرفی‌های حمایت‌شده</h2>
            @foreach (var advertisement in Model.Advertisements)
            {
                var link = advertisement.Link;
                var imageUrl = string.IsNullOrWhiteSpace(advertisement.ImageUrl)
                    ? null
                    : Url.Content(advertisement.ImageUrl);
                var isSafeLink = !string.IsNullOrWhiteSpace(link) &&
                    (Url.IsLocalUrl(link) ||
                     (Uri.TryCreate(link, UriKind.Absolute, out var absoluteLink) &&
                      (absoluteLink.Scheme == Uri.UriSchemeHttps || absoluteLink.Scheme == Uri.UriSchemeHttp)));

                <article class="sponsored-card">
                    @if (isSafeLink)
                    {
                        <a href="@link" rel="sponsored noopener noreferrer">
                            @if (imageUrl is not null)
                            {
                                <img src="@imageUrl" alt="@advertisement.ImageAlt" loading="lazy" />
                            }
                            <span>@(string.IsNullOrWhiteSpace(advertisement.ImageAlt) ? "مشاهده‌ی معرفی حمایت‌شده" : advertisement.ImageAlt)</span>
                        </a>
                    }
                    else
                    {
                        @if (imageUrl is not null)
                        {
                            <img src="@imageUrl" alt="@advertisement.ImageAlt" loading="lazy" />
                        }
                        <span>@(string.IsNullOrWhiteSpace(advertisement.ImageAlt) ? "معرفی حمایت‌شده" : advertisement.ImageAlt)</span>
                    }
                    <small>تبلیغ</small>
                </article>
            }
        </section>
    }

    @if (Model.LatestArticles.Count > 0)
    {
        <section class="right-panel-card" aria-labelledby="latest-articles-title">
            <h2 class="right-panel-title" id="latest-articles-title">آخرین مطالب</h2>
            @foreach (var article in Model.LatestArticles)
            {
                <a class="right-panel-item"
                   asp-route="NewsApp/{id}"
                   asp-route-articleId="@article.Id">
                    <strong>@article.Title</strong>
                    @if (!string.IsNullOrWhiteSpace(article.SubTitle))
                    {
                        <span>@article.SubTitle</span>
                    }
                </a>
            }
        </section>
    }

    @if (Model.NewDrugs.Count > 0)
    {
        <section class="right-panel-card" aria-labelledby="new-drugs-title">
            <h2 class="right-panel-title" id="new-drugs-title">تازه‌های دارویی</h2>
            @foreach (var drug in Model.NewDrugs)
            {
                <a class="right-panel-item"
                   asp-route="BrandInfo"
                   asp-route-IRC="@drug.Irc"
                   asp-route-BrandEngName="@darooyab_rewrite.Routing.DrugUrl.CreateSlug(drug.EnglishName)">
                    <strong>@drug.PersianName</strong>
                    <span>@drug.EnglishName</span>
                </a>
            }
        </section>
    }

    @if (Model.FrequentlyUsedDrugs.Count > 0)
    {
        <section class="right-panel-card" aria-labelledby="frequently-used-title">
            <h2 class="right-panel-title" id="frequently-used-title">داروهای پرمصرف</h2>
            @foreach (var drug in Model.FrequentlyUsedDrugs)
            {
                <a class="right-panel-item"
                   asp-route="G-{DrugId}/{EngGenericName}"
                   asp-route-DrugId="@drug.DrugId"
                   asp-route-EngGenericName="@darooyab_rewrite.Routing.DrugUrl.CreateSlug(drug.EnglishName)">
                    <strong>@drug.PersianName</strong>
                    <span>@drug.EnglishName</span>
                </a>
            }
        </section>
    }

    @if (Model.LatestNews.Count > 0)
    {
        <section class="right-panel-card" aria-labelledby="latest-news-title">
            <h2 class="right-panel-title" id="latest-news-title">آخرین اخبار</h2>
            @foreach (var news in Model.LatestNews)
            {
                <article class="right-panel-item">
                    <strong>@news.Title</strong>
                    @if (!string.IsNullOrWhiteSpace(news.SubTitle))
                    {
                        <span>@news.SubTitle</span>
                    }
                </article>
            }
        </section>
    }

    @if (Model.DataUnavailable)
    {
        <p class="right-panel-status" role="status">برخی اطلاعات این ستون در حال حاضر در دسترس نیست.</p>
    }
</div>
