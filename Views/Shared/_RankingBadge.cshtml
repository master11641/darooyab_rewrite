@model short
@if (Model > 0)
{
    <span class="ranking-badge">
        @if (Model <= 10)
        {
            <img src="~/Content/Images/ranking@(Model).webp"
                 asp-append-version="true"
                 alt="رتبه‌ی تضمین موجودی @Model"
                 width="48"
                 height="48"
                 loading="lazy" />
        }
        <span>رتبه‌ی تضمین موجودی @Model</span>
    </span>
}
