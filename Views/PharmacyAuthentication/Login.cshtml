@model darooyab_rewrite.ViewModels.PharmacyLoginViewModel

@{
    ViewData["Title"] = "ورود مدیر داروخانه";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pharmacy-login.css" asp-append-version="true" />
}

<section class="pharmacy-login-page">
    <nav class="pharmacy-login-breadcrumb" aria-label="مسیر صفحه">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-controller="Home" asp-action="Index">خانه</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">ورود داروخانه</li>
        </ol>
    </nav>

    <header class="pharmacy-login-hero site-hero site-hero--glass site-hero--inner">
        <div class="pharmacy-login-hero-copy">
            <span class="pharmacy-login-kicker">پنل اختصاصی داروخانه</span>
            <h1>ورود مدیر داروخانه</h1>
            <p>برای دسترسی به خدمات و مدیریت حساب داروخانه، با اطلاعات ورود خود وارد شوید.</p>
        </div>
        <div class="pharmacy-login-emblem" aria-hidden="true">
            <span>✚</span>
            <small>دارویاب</small>
        </div>
    </header>

    <div class="row pharmacy-login-row">
        <div class="col-12">
            <div class="card pharmacy-login-card">
                <div class="card-body pharmacy-login-card-body">
                    <div class="pharmacy-login-card-heading">
                        <span class="pharmacy-login-kicker">ورود امن</span>
                        <h2>اطلاعات حساب خود را وارد کنید</h2>
                        <p>از همان شماره‌ی همراه و کلمه‌ی عبوری که پیش‌تر استفاده می‌کردید، استفاده کنید.</p>
                    </div>

                    <form asp-controller="PharmacyAuthentication"
                          asp-action="Login"
                          method="post"
                          class="pharmacy-login-form">
                        <input asp-for="ReturnUrl" type="hidden" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="UserName" class="form-label">نام کاربری / شماره‌ی همراه</label>
                            <input asp-for="UserName"
                                   class="form-control"
                                   autocomplete="username"
                                   inputmode="tel"
                                   dir="ltr"
                                   maxlength="32" />
                            <span asp-validation-for="UserName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">کلمه‌ی عبور</label>
                            <input asp-for="Password"
                                   class="form-control"
                                   type="password"
                                   autocomplete="current-password"
                                   dir="auto"
                                   maxlength="256" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <partial name="_CaptchaChallengeFields" />

                        <button type="submit" class="btn btn-primary w-100 mt-3 pharmacy-login-submit">ورود به پنل</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
